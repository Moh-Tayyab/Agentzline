# =============================================================================
# AgentZline — Bronze Tier MVP Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AgentZline
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agentzline:changeme@localhost:5432/agentzline
DATABASE_ECHO=false          # Set true to log all SQL statements

# ── Encryption (Fernet key for token vault) ─────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_ENCRYPTION_KEY=CHANGE_ME_TO_A_REAL_FERNET_KEY

# ── Meta Graph API ───────────────────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_SYSTEM_USER_TOKEN=your_system_user_access_token
META_BUSINESS_ID=your_meta_business_id
META_API_VERSION=v19.0

# ── WhatsApp Business API ────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_WEBHOOK_PORT=8000

# ── Anthropic API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Scheduling ───────────────────────────────────────────────────────────────
DAILY_REPORT_TIME=09:00      # 24-hour format, local timezone (PKT)
REPORT_TIMEZONE=Asia/Karachi
SCHEDULER_JITTER_MAX_SECONDS=300 # Max random delay in seconds (0-300s) to avoid 9 AM thundering herd
TOKEN_EXPIRY_WARNING_DAYS=7 # Warn when a vault token expires within this many days

# ── Bronze Tier Thresholds ──────────────────────────────────────────────────
DEFAULT_TARGET_ROAS=1.5
DEFAULT_TARGET_CPA_PKR=500
CPA_SURGE_THRESHOLD_PERCENT=25     # Alert if CPA exceeds target by this %
BUDGET_CEILING_DAILY_INCREASE_PCT=20  # Max daily budget increase (hard limit)

# ── Phase-2 Intraday Pacing Alerts ───────────────────────────────────────────
INTRADAY_BLEED_SPEND_RATIO=0.5     # Alert when intraday spend exceeds this fraction of daily budget
INTRADAY_BLEED_CTR_THRESHOLD=0.6   # ... with zero conversions and CTR below this %
INTRADAY_SUPPRESSION_HOURS=24      # Max 1 pacing alert per campaign per window

# ── Security & CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (never use wildcard '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ── Phase-3 Silver Tier HITL Action Tokens ──────────────────────────────────
ACTION_TOKEN_SECRET=               # Secret for signing WhatsApp buttons (falls back to FERNET key if empty)
ACTION_TOKEN_EXPIRY_MINUTES=15     # Validity period for interactive WhatsApp buttons

# ── Phase-4 Gold Tier Courier Webhook Security ──────────────────────────────
# Protects PostEx / Trax / Leopards / Swyft webhooks against forged status posts
COURIER_WEBHOOK_SECRET=            # Secret token configured in courier merchant webhook headers
