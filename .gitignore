# =============================================================================
# AgentZline .gitignore
# =============================================================================

# Environment variables — NEVER commit
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv lock (optional — commit if you want reproducible builds)
# uv.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Database
*.sqlite3
*.db

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Alembic
alembic/versions/__pycache__/
